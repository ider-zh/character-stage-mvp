{
  "name": "character-stage-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node --experimental-strip-types server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node --experimental-strip-types server/index.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "prepare:camera": "node scripts/prepare-camera.mjs",
    "test:production": "node --experimental-strip-types scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "pixi.js": "8.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "6.0.3",
    "vite": "7.3.6"
  }
}
