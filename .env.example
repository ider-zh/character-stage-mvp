# Node 24+, optional: node --env-file=.env --experimental-strip-types server/index.ts
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
# Comma-separated exact origins; must include the browser-facing Vite or reverse proxy origin.
ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,http://127.0.0.1:5173,http://localhost:5173
# Set 1 ONLY when served through HTTPS to mark session cookie Secure.
COOKIE_SECURE=0
# No image API is wired up. Generation/layering provider contracts are in server/providers.ts.
